# limafinance: configuração do SEU deploy. Copie para `limafinance.env` (ignorado pelo git).
#
#   cp limafinance.env.example limafinance.env
#   uv run --no-project ci/deploy_your_own.py          # cria o que falta, preenche os IDs aqui e publica
#
# No CI (GitHub Actions) as MESMAS chaves vêm de "Variables" de cada Environment (staging / production).
# Nada aqui é segredo: segredos (GOOGLE_CLIENT_SECRET, ALLOWED_EMAILS) ficam na Cloudflare via `wrangler secret put`.

# ---- você preenche -----------------------------------------------------------------------------
# Prefixo de todos os nomes (Workers, D1, KV, filas). Ex.: "limafinance" →
#   production: limafinance (mcp), limafinance-auth (auth) · staging: limafinance-staging, limafinance-auth-staging
LF_PREFIX=limafinance

# Subdomínio workers.dev da sua conta: <worker>.<CF_WORKERS_SUBDOMAIN>.workers.dev
# (dash.cloudflare.com → Workers & Pages → no canto direito "Subdomain")
CF_WORKERS_SUBDOMAIN=

# Conta Cloudflare (opcional se você só tem uma; `npx wrangler whoami` mostra o ID)
CF_ACCOUNT_ID=

# OAuth client "Web application" do Google (o deploy_your_own imprime os redirect URIs para cadastrar)
GOOGLE_CLIENT_ID=

# ---- preenchidos pelo deploy_your_own (ou à mão) ------------------------------------------------
D1_ID_PRODUCTION=
KV_ID_PRODUCTION=
D1_ID_STAGING=
KV_ID_STAGING=

# Domínio próprio ainda não é suportado pelo gerador (exigiria rotas/custom domains no wrangler).
